# Supabase CLI environment variables — used by supabase/config.toml via env()
# Copy to supabase/.env and fill in values.
# This file is for LOCAL DEVELOPMENT only — do NOT commit supabase/.env to git.

# Required for Google OAuth local dev (optional — leave blank to disable)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Optional — used by Supabase Studio's AI SQL assistant
OPENAI_API_KEY=
